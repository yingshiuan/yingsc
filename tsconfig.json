{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*.astro",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    // No "baseUrl": deprecated in TS 5.5+, removed in TS 7.
    // `paths` values are tsconfig-relative, which TS 4.4+ supports on its own.
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  }
}