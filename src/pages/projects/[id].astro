---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import ProjectContent from '@/components/grids/ProjectContent.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  // The glob loader strips the extension and trailing `/index`, so the
  // collection id is already the route segment (`afatt/index.md` -> `afatt`).
  return projects.map((project) => ({
    params: {
      id: project.id,
    },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props as {
  project: CollectionEntry<'projects'>;
};

const baseUrl = import.meta.env.BASE_URL;

// og:image needs an absolute URL, and `image()` gives us the built asset path.
const ogImage = new URL(project.data.image.src, Astro.site ?? Astro.url).href;
---

<Layout
  title={project.data.title}
  description={project.data.info}
  image={ogImage}
  keywords={project.data.tags}
  alt={project.data.title}
>
  <!-- <h1>{project.data.title}</h1>
  <img
    src={imageSrc}
    alt={project.data.title}
    class=""
  />
  {project.data.tags && <Tag tags={project.data.tags} />}
  <p>{project.data.description}</p> 
  -->

  <!-- Markdown body content -->
  <article class="prose">
    <ProjectContent project={project} baseUrl={baseUrl} />
  </article>
</Layout>
