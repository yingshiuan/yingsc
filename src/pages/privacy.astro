---
import Layout from '@/layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { analytics, retention } from '@/ts/site.ts';

const baseUrl = import.meta.env.BASE_URL;

const privacyCollection = await getCollection('privacy');
const privacy = privacyCollection[0];

if (!privacy) {
  throw new Error('Privacy content not found');
}

const { Content } = await render(privacy);

// Not a date literal: this renders at build time, so a deploy always shows the
// day the deployed copy was built rather than the day it is read.
const lastUpdated = new Date().toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// The per-property cookie is named after the measurement ID with the `G-`
// dropped, so deriving it keeps the table honest if the ID in site.ts changes.
const propertyCookie = `_ga_${analytics.measurementId.replace(/^G-/, '')}`;

// Rendered here rather than written into the markdown so the figures have one
// source. Everything factual about lifetimes comes from `retention`.
const cookies = [
  {
    name: '_ga',
    purpose:
      'Distinguishes one visitor from another so repeat visits are not counted as new people.',
    life: retention.cookies,
    when: 'Only after Accept',
  },
  {
    name: propertyCookie,
    purpose: 'Keeps the state of a single visit (session) for this property.',
    life: retention.cookies,
    when: 'Only after Accept',
  },
  {
    name: 'analytics_consent',
    purpose:
      'Remembers whether you accepted or rejected, so you are not asked on every page. Stored in localStorage, not sent to any server.',
    life: retention.consent,
    when: 'After either choice',
  },
];
---

<Layout
  title={privacy.data.title}
  description={privacy.data.description}
  alt="Privacy policy"
  keywords={privacy.data.keywords}
>
  <section class="privacy">
    <h2>{privacy.data.title}</h2>
    <hr />
    <p class="updated">Last updated {lastUpdated}</p>

    <div class="privacy-content">
      <Content />
    </div>

    <!-- The reference section is built from src/ts/site.ts rather than written
         into the markdown, so the lifetimes stated here cannot drift from the
         ones the site actually applies. It closes the page for that reason:
         the prose above points down to it instead of repeating the numbers. -->
    <h4 class="reference-heading">What gets stored, and for how long</h4>

    <!-- `tabindex` is what makes the overflow reachable without a mouse: a
         scrolling box that cannot be focused strands keyboard users at
         whatever the viewport happens to cut off (axe
         `scrollable-region-focusable`). Named so it is not an anonymous stop
         in the tab order. -->
    {/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex --
        the rule and axe want opposite things here. A scrolling box with no
        focusable content inside it is unreachable by keyboard, which is what
        `scrollable-region-focusable` flags; making it focusable is the fix
        axe asks for, so the rule is the one that gives way. */}
    <div
      class="table-wrap"
      tabindex="0"
      role="region"
      aria-label="Cookies and storage used by this site"
    >
      <table>
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Purpose</th>
            <th scope="col">Expires</th>
            <th scope="col">Set</th>
          </tr>
        </thead>
        <tbody>
          {
            cookies.map((cookie) => (
              <tr>
                <th scope="row">
                  <code>{cookie.name}</code>
                </th>
                <td>{cookie.purpose}</td>
                <td>{cookie.life}</td>
                <td>{cookie.when}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}

    <p>
      Event data in Google Analytics is retained for {retention.events}, after
      which Google deletes it. Aggregate reports — visit counts and the like —
      are not affected by that deletion and are kept for as long as the property
      exists. Your stored consent choice lives on your own device for {
        retention.consent
      } and is never transmitted anywhere.
    </p>

    <p class="back"><a href={`${baseUrl}`}>Back to home</a></p>
  </section>
</Layout>

<style>
  @reference "@/styles/global.css";

  /* Narrower than the 80rem the sitemap uses. That page is a scannable index;
     this one is read line by line, and 80rem of monospace is well past a
     comfortable measure. */
  .privacy {
    @apply px-[2.5rem] my-[12rem] mx-auto max-w-[60rem];
  }

  /* `opacity-70` would be the obvious way to mute this, but --color-text-primary
     is 7.0:1 on white by design and 70% of it lands under 4.5:1 — dark mode
     survives the same treatment at 11.8:1, so it fails in light only.
     --color-text-secondary is the palette's answer: pre-checked at 5.0:1. */
  .updated {
    @apply mt-4 text-sm text-[var(--color-text-secondary)];
  }

  .reference-heading,
  :global(.privacy-content h4) {
    @apply mt-[3rem] mb-[1.5rem] text-lg font-medium border-b-[1.5px] border-[var(--color-text-primary)] p-[0.2rem];
  }

  :global(.privacy-content p) {
    @apply mb-[1.25rem];
  }

  :global(.privacy-content ul) {
    @apply list-disc ml-6 mb-[1.25rem];
  }

  :global(.privacy-content li) {
    @apply mb-2 leading-relaxed;
  }

  /* The global rule strips underlines from every anchor, which is fine for
     navigation but not here: in a policy the links are part of the sentence
     and have to look clickable without relying on colour alone. */
  :global(.privacy-content a),
  .privacy a {
    @apply underline underline-offset-4 text-[var(--color-text-primary)] hover:text-[var(--color-text-hover)] hover:text-shadow-[0.05rem_0.05rem_var(--color-text-primary)];
  }

  code,
  :global(.privacy-content code) {
    @apply text-sm px-1 py-0.5 bg-[var(--color-work-background)] rounded;
  }

  /* Revealed by Analytics.astro only on a build where the consent bar exists,
     so the page never offers to open something that is not there. */
  :global(.privacy-content .settings_button) {
    @apply cursor-pointer border-[1.5px] border-[var(--color-text-primary)] text-[var(--color-text-primary)] px-3 py-1 text-sm rounded-full
      hover:bg-[var(--color-text-primary)] hover:text-[var(--background-color)]
      focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2
      focus-visible:ring-[var(--color-text-primary)] focus-visible:ring-offset-[var(--background-color)];
  }

  /* Four columns of monospace do not fit a phone. Scrolling the table inside
     its own box keeps the page itself from scrolling sideways. */
  .table-wrap {
    @apply overflow-x-auto mb-[1.25rem];
  }

  /* It is in the tab order now, so it has to show that it is. */
  .table-wrap:focus-visible {
    @apply outline-none ring-2 ring-offset-2 ring-[var(--color-text-primary)] ring-offset-[var(--background-color)];
  }

  table {
    @apply w-full text-left text-sm border-collapse min-w-[36rem];
  }

  th,
  td {
    @apply align-top p-3 border-b border-[var(--color-rule)];
  }

  thead th {
    @apply font-semibold;
  }

  tbody th {
    @apply font-normal whitespace-nowrap;
  }

  .back {
    @apply mt-12;
  }
</style>
