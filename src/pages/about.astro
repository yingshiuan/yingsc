---
import Layout from '@/layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

interface Props {
  profileImage?: string;
  gifImage?: string;
}

const baseUrl = import.meta.env.BASE_URL;

const {
  profileImage = 'images/about/ying.jpg',
  gifImage = 'images/about/hihi.webp',
} = Astro.props;

const profileImagePath = `${baseUrl}${profileImage}`;
const gifImagePath = `${baseUrl}${gifImage}`;

const aboutMeCollection = await getCollection('about');
const aboutMe = aboutMeCollection[0];

if (!aboutMe) {
  throw new Error('About content not found');
}

const roleTitle = aboutMe.data.role ?? 'Product Engineer';

// The copy lives in the content file. These splits keep the role bold and the
// company a link without embedding markup in the frontmatter.
const introBlock = aboutMe.data.intro;

const summaryParts = introBlock?.summary.split(roleTitle) ?? [];

const currentLink = introBlock?.currentLink;
const currentParts =
  introBlock?.current && currentLink
    ? introBlock.current.split(currentLink.label)
    : null;

const { Content } = await render(aboutMe);
---

<Layout
  title="About"
  description="How Ying-Shiuan Chen went from architecture and robotic fabrication at ETH Zürich to building AI-powered products and interactive interfaces."
  image={profileImagePath}
  alt="Portrait of Ying-Shiuan Chen"
  keywords={[
    'Ying-Shiuan Chen',
    'Product Engineer',
    'ETH Zürich',
    'Architecture and Digital Fabrication',
    'Human-Centered Design',
    'Interaction Design',
  ]}
  schemaType="AboutPage"
>
  <!-- Content -->
  <section class="aboutMe">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Text section -->
      <div class="lg:col-span-8 space-y-6">
        <h5>
          {introBlock?.greeting}<span class="material-symbols-outlined">
            pets
          </span>
        </h5>
        <p>
          {
            summaryParts.length > 1 ? (
              <>
                {summaryParts[0]}
                <b>{roleTitle}</b>
                {summaryParts.slice(1).join(roleTitle)}
              </>
            ) : (
              introBlock?.summary
            )
          }<span class="material-symbols-outlined">star</span>
        </p>
        {
          currentParts && currentLink && (
            <p>
              {currentParts[0]}
              <a
                href={currentLink.href}
                target="_blank"
                rel="noopener noreferrer">
                {currentLink.label}
              </a>
              {currentParts.slice(1).join(currentLink.label)}
            </p>
          )
        }
        <div>
          <p>
            Check out my{' '}
            <a
              href={`${baseUrl}projects`}
              target="_blank"
              rel="noopener noreferrer"
            >
              projects
            </a>, or <a
              href={`${baseUrl}content/resume/Ying-Shiuan Chen-Resume.pdf`}
              target="_blank"
              rel="noopener noreferrer"
            >
              PDF Resume
            </a>, connect with me on <a
              href="https://www.linkedin.com/in/chenyingshiuan/"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>.
          </p>
        </div>
      </div>

      <!-- Images section -->
      <div class="lg:col-span-4 flex flex-col items-center gap-4">
        <div class="static_image group">
          <!-- static profile image -->
          <img
            src={profileImagePath}
            alt="ying"
            class="profile_image group-hover:opacity-0"
          />

          <!-- GIF image -->
          <img
            src={gifImagePath}
            alt="ying-hihi"
            class="profile_image absolute top-0 left-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
          />
        </div>
      </div>
    </div>

    <div class="about-content">
      <Content />
    </div>

    <p class="aboutMeContainer">
      For the complete list of my skills and experience, visit my{' '}
      <a href={`${baseUrl}resume`}>resume</a>.
    </p>
  </section>
</Layout>

<style>
  @reference "@/styles/global.css";

  a {
    @apply underline text-[var(--color-text-primary)] hover:text-[var(--color-text-hover)] hover:text-shadow-[0.05rem_0.05rem_var(--color-text-primary)];
  }

  .aboutMe {
    @apply px-[2.5rem] my-[12rem] mx-auto;
  }

  .static_image {
    @apply relative w-72 h-72;
  }

  .profile_image {
    @apply w-full h-full rounded-full transition-opacity duration-500;
  }

  .showgif {
    @apply hidden;
  }

  .aboutMeContainer {
    @apply my-[2.5rem] max-w-[46rem];
  }

  @media (min-width: 900px) {
    .aboutMe {
      @apply max-w-[80rem];
    }
  }

  /* about content styling */

  /* Caps the measure at roughly 70 characters in DM Mono. Left-aligned rather
     than centred so the body stays anchored to the intro column above it. */
  .about-content {
    @apply max-w-[80rem];
  }

  :global(.about-content h4) {
    @apply flex mt-[4rem] mb-[1.5rem] gap-2 flex-wrap text-lg font-medium border-b-[1.5px] border-[var(--color-text-primary)] p-[0.2rem];
  }

  /* The first heading follows the intro block, which already has its own gap. */
  :global(.about-content > h4:first-child) {
    @apply mt-0;
  }

  :global(.about-content p) {
    @apply mb-[1.25rem];
  }

  /* The global rule gives these 0.5rem of vertical padding, which inflates the
     line box and makes icon-bearing lines taller than the rest of a paragraph.
     Scoped to the prose so the rest of the site keeps its spacing. */
  :global(.about-content .material-symbols-outlined) {
    @apply py-0 leading-none;
  }

  :global(.about-content h4:hover) {
    @apply border-[var(--color-caption-primary)] bg-[var(--color-text-hover)] text-[var(--color-border)] shadow-[0.1rem_0.1rem_var(--color-caption-secondary)] transition duration-300;
  }

  :global(.about-content a) {
    @apply underline text-[var(--color-text-primary)] hover:text-[var(--color-text-hover)] hover:text-shadow-[0.05rem_0.05rem_var(--color-text-primary)];
  }
</style>
