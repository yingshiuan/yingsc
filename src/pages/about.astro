---
import Layout from '@/layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

interface Props {
  profileImage?: string;
  gifImage?: string;
}

const baseUrl = import.meta.env.BASE_URL;

const {
  profileImage = 'images/about/ying.jpg',
  gifImage = 'images/about/hihi.webp',
} = Astro.props;

const profileImagePath = `${baseUrl}${profileImage}`;
const gifImagePath = `${baseUrl}${gifImage}`;

const aboutMeCollection = await getCollection('about');
const aboutMe = aboutMeCollection[0];

if (!aboutMe) {
  throw new Error('About content not found');
}

const roleTitle = aboutMe.data.role ?? 'Product Engineer';

const { Content } = await render(aboutMe);
---

<Layout
  title="About Me"
  description="Ying-Shiuan Chen loves creating functional yet fun interactions to humanize technology!"
  image={profileImagePath}
  keywords="Ying-Shiuan Chen, software engineer, product designer, developer, interaction"
>
  <!-- Content -->
  <section class="aboutMe">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Text section -->
      <div class="lg:col-span-8 space-y-6">
        <h5>
          Hi Hi! I'm Ying.<span class="material-symbols-outlined">pets</span>
        </h5>
        <p>
          I am a <b>{roleTitle}</b>, at the intersection of AI, spatial
          computing, and human-centered technology—building interactive systems
          that bridge digital and physical experiences.<span
            class="material-symbols-outlined"
          >
            star
          </span>
        </p>
        <p>
          I'm wrapping up a research internship at
          <a
            href="https://studios.disneyresearch.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            DisneyResearch|Studios
          </a>
          in Zürich, where I've been creating AI-powered data platforms and interactive
          web applications.
        </p>
        <div>
          <p>
            Check out my
            <a
              href={`${baseUrl}projects`}
              target="_blank"
              rel="noopener noreferrer"
            >
              projects
            </a>, or <a
              href={`${baseUrl}content/resume/Ying-Shiuan Chen-Resume.pdf`}
              target="_blank"
              rel="noopener noreferrer"
            >
              PDF Resume
            </a>, connect with me on <a
              href="https://www.linkedin.com/in/chenyingshiuan/"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>,
          </p>
        </div>
      </div>

      <!-- Images section -->
      <div class="lg:col-span-4 flex flex-col items-center gap-4">
        <div class="static_image group">
          <!-- static profile image -->
          <img
            src={profileImagePath}
            alt="ying"
            class="profile_image group-hover:opacity-0"
          />

          <!-- GIF image -->
          <img
            src={gifImagePath}
            alt="ying-hihi"
            class="profile_image absolute top-0 left-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
          />
        </div>
      </div>
    </div>

    <div class="lg:col-span-12 space-y-6">
      <div class="about-content">
        <Content />
      </div>
    </div>

    <h5 class="aboutMeContainer">
      - For the complete list of my skills and experience, visit my
      <a href={`${baseUrl}resume`} target="_blank" rel="noopener noreferrer">
        resume
      </a>
    </h5>
  </section>
</Layout>

<style>
  @reference "@/styles/global.css";

  a {
    @apply underline text-[var(--color-text-primary)] hover:text-[var(--color-text-hover)] hover:text-shadow-[0.05rem_0.05rem_var(--color-text-primary)];
  }

  .aboutMe {
    @apply px-[2.5rem] my-[12rem] mx-auto;
  }

  .static_image {
    @apply relative w-72 h-72;
  }

  .profile_image {
    @apply w-full h-full rounded-full transition-opacity duration-500;
  }

  .showgif {
    @apply hidden;
  }

  .aboutMeContainer {
    @apply my-[2.5rem];
  }

  @media (min-width: 900px) {
    .aboutMe {
      @apply max-w-[80rem];
    }
  }

  /* about content styling */
  :global(.about-content h4) {
    @apply flex mt-[1.5rem] gap-2 flex-wrap text-lg font-medium border-b-[1.5px] border-[var(--color-text-primary)] p-[0.2rem];
  }

  :global(.about-content h4:hover) {
    @apply border-[var(--color-caption-primary)] bg-[var(--color-text-hover)] text-[var(--color-border)] shadow-[0.1rem_0.1rem_var(--color-caption-secondary)] transition duration-300;
  }

  :global(.about-content a) {
    @apply underline text-[var(--color-text-primary)] hover:text-[var(--color-text-hover)] hover:text-shadow-[0.05rem_0.05rem_var(--color-text-primary)];
  }
</style>
