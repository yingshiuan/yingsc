---
import Layout from '@/layouts/Layout.astro';
import Intro from '@/components/layout/Intro.astro';
import Square from '@/components/grids/Square.astro';
import TechnicalFocus from '@/components/layout/TechnicalFocus.astro';
import ExperienceHighlights from '@/components/layout/ExperienceHighlights.astro';
import About from '@/components/layout/About.astro';
import ContactCTA from '@/components/layout/ContactCTA.astro';

---

<Layout
  title="Product Engineer"
  description="Ying-Shiuan Chen is a Product Engineer in Zürich building AI-powered systems, interactive interfaces, and spatial computing experiences."
  alt="Ying-Shiuan Chen — Product Engineer portfolio">
  <!-- Intro  -->
  <div class="my-[12rem]">
    <Intro />
  </div>

  <Square />
  <div class="my-[12rem]"><TechnicalFocus /></div>
  <div class="my-[12rem]"><ExperienceHighlights /></div>
  <div class="my-[12rem]"><About /></div>
  <ContactCTA />
</Layout>
