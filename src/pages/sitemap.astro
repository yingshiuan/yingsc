---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import type { ProjectMeta } from '@/ts/project';

const baseUrl = import.meta.env.BASE_URL;

const projects = (await getCollection('projects')).sort((a, b) => {
  const aDate = a.data.created;
  const bDate = b.data.created;

  if (!aDate && !bDate) return 0;
  if (!aDate) return 1;
  if (!bDate) return -1;

  return new Date(bDate).getTime() - new Date(aDate).getTime();
});

type ProjectsByCategory = {
  [type: string]: ProjectMeta[];
};

const projectsByCategory: ProjectsByCategory = projects.reduce(
  (acc: ProjectsByCategory, project) => {
    const type = project.data.type || 'Other';

    if (!acc[type]) acc[type] = [];

    acc[type].push({
      ...project.data,
      slug: project.data.slug || project.slug,
      // || project.data.title.toLowerCase().trim().replace(/\s+/g, '-').replace(/[^\w-]/g, '')
    } as ProjectMeta);

    return acc;
  },
  {},
);

interface TreeNode {
  label: string;
  href: string;
  meta?: string;
  children?: TreeNode[];
}

const siteTree: TreeNode[] = [
  { label: 'Home', href: `${baseUrl}` },
  { label: 'About', href: `${baseUrl}about` },
  { label: 'Resume', href: `${baseUrl}resume` },
  {
    label: 'Projects',
    href: `${baseUrl}projects`,
    children: Object.entries(projectsByCategory).map(
      ([type, items]): TreeNode => ({
        label: type,
        href: `${baseUrl}projects/${type}`, // Add href for the category itself, Currently points to a non-existent page
        children: items
          .slice()
          .sort((a, b) => {
            const aDate = a.created;
            const bDate = b.created;

            if (!aDate && !bDate) return 0;
            if (!aDate) return 1;
            if (!bDate) return -1;

            return new Date(bDate).getTime() - new Date(aDate).getTime();
          })
          .map((project) => ({
            label: project.title,
            href: `${baseUrl}projects/${project.slug}`,
            meta: [
              project.domains?.length ? project.domains.join(' | ') : '',
              // project.stack?.length ? project.stack.join(' · ') : '',
            ]
              .filter(Boolean)
              .join(' | '),
          })),
      }),
    ),
  },
];
---

<html lang="en">
  <head>
    <title>Site Sitemap</title>
    <meta name="robots" content="noindex" />
  </head>

  <Layout
    title="Sitemap | Ying-Shiuan Chen"
    description="Ying-Shiuan Chen loves creating functional yet fun interactions to humanize technology!"
    image="./yinz.png"
    keywords="Ying-Shiuan Chen, software engineer, product designer, developer, interaction">
    <div class="sitemap my-[12rem]">
      <h2>Site Sitemap</h2>
      <hr />
      <br />
      <!-- Render tree inline recursively -->
      <ul class="ml-0">
        {
          siteTree.map((node) => (
            <li class="mt-1">
              <h3>
                <a href={node.href}>{node.label}</a>
              </h3>
              {node.children && (
                <ul class="ml-4 list-disc">
                  {node.children.map((child) => (
                    <li class="ml-4 mt-1">
                      <h4>{child.label}</h4>
                      {/* <a href={child.href}></a>  */}
                      {child.children && (
                        <ul class="ml-4 list-disc text-xl">
                          {child.children.map((grandchild) => (
                            <li class="mb-4">
                              <a href={grandchild.href}>{grandchild.label}</a>
                              {grandchild.meta && (
                                <div class="projectMeta">{grandchild.meta}</div>
                              )}
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </Layout>

  <style>
    @reference "@/styles/global.css";

    .sitemap {
      @apply px-[2.5rem] mx-auto;
    }

    .sitemap a {
      @apply hover:underline;
    }

    .projectMeta {
      @apply mt-1 text-sm opacity-70;
    }

    @media (min-width: 900px) {
      .sitemap {
        @apply max-w-[80rem];
      }
    }
  </style>


</html>
