---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import MetaCard from '@/components/content/MetaCard.astro';
import ProjectThumbnail from '@/components/content/ProjectThumbnail.astro';
import ContentFooter from '@/components/content/ContentFooter.astro';
import SectionNav from '@/components/content/SectionNav.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  baseUrl?: string;
}

// load the data
const { project, baseUrl } = Astro.props;

const { Content, headings } = await render(project);

const words = project.body
  ? project.body.replace(/<[^>]*>/g, ' ').split(/\s+/).filter(Boolean).length
  : 0;
---

<div class="project-content">
  <!-- Project Meta -->
  <div class="mt-[12rem] mb-[4rem]">
    <MetaCard project={project} />
  </div>
  <div class="projectThumbnail">
    <ProjectThumbnail project={project} />
  </div>

  <SectionNav headings={headings} words={words} />

  <!-- Markdown content -->
  <article class="content custom-markdown">
    <Content />
  </article>

  <ContentFooter project={project} baseUrl={baseUrl}>
    <!-- <img src=`${baseUrl}images/projects/multi-multi/prototype.gif` alt="" loading="lazy" decoding="async" class="w-full object-cover" /> -->
  </ContentFooter>

  <style>
    @reference "@/styles/global.css";

    /* Base: Mobile */
    :global(.content, .contentFooter) {
      @apply px-[1.5rem] my-[6rem] mx-auto;
    }

    :global(.content .contentSection) {
      @apply mb-[6rem];
    }

    :global(.content h1),
    :global(.content h2),
    :global(.content h3),
    :global(.content h4) {
      @apply mt-[3rem];
    }

    /* Jumping to a section must clear the fixed header and the sticky nav, or
       the heading lands underneath both. SectionNav measures and publishes the
       distance; the fallback covers the pages that render no nav. */
    :global(.content :is(h2, h3, h4, h5, h6)[id]) {
      scroll-margin-top: var(--project-nav-offset, 6rem);
    }

    :global(.content h5),
    :global(.content h6) {
      @apply mt-[2rem];
    }

    /* Project sections */
    :global(.content .projectGoal) {
      @apply grid grid-cols-1 md:grid-cols-3 gap-6;
    }

    :global(.content .projectGoal img) {
      @apply h-full object-cover;
    }

    /* Lists
       The marker hangs in a gutter rather than sitting in a flex row with the
       text. As flex containers these items made a separate flex item of every
       inline child — so a bullet opening with a bold lead-in became two
       columns, and the body of each one started at whatever width its own
       lead-in happened to wrap to. Absolute markers leave the content to flow
       as ordinary text, which is what a list item is. */
    :global(.content ul),
    :global(.content ol) {
      @apply list-none pl-0;
    }

    :global(.content ol) {
      counter-reset: item;
    }

    :global(.content ul li) {
      @apply relative pl-[1.25rem];
    }

    :global(.content ul li::before) {
      content: '-';
      @apply absolute left-0 top-0;
    }

    :global(.content ol li) {
      counter-increment: item;
      @apply relative pl-[2.25rem];
    }

    /* Right-aligned in a fixed gutter so the text edge holds whether the list
       reaches 9 or 20 — the longest of these runs to 20. */
    :global(.content ol li::before) {
      content: counter(item) '.';
      @apply absolute left-0 top-0 w-[1.75rem] text-right font-semibold;
    }

    /* Markdown emits <p> children for a loose list; without this they inherit
       paragraph margins and the gap between items doubles. */
    :global(.content li > p) {
      @apply m-0;
    }

    :global(.content li + li) {
      @apply mt-[0.75rem];
    }

    /* Links */
    :global(.content a) {
      @apply underline;
    }

    /* Images */
    :global(.content img) {
      @apply mx-auto;
    }

    :global(.content video) {
      @apply mx-auto w-full rounded-[1rem];
    }

    /* Portrait capture: full width would run past 2600px tall. */
    :global(.content video.phone) {
      @apply block max-w-[20rem];
    }

    /* Layout */
    :global(.content .colsLayout) {
      @apply flex flex-col lg:flex-row items-center gap-8;
    }

    :global(.content .col) {
      @apply flex-1;
    }

    /* Embed */
    :global(.content .embedFrame) {
      @apply mx-auto w-full max-w-screen-lg aspect-[16/9];
    }

    /* Tables */
    :global(.content table) {
      @apply w-full my-8 border-collapse;
    }

    :global(.content th),
    :global(.content td) {
      @apply border px-4 py-3 align-top text-left;
    }

    :global(.content th) {
      @apply font-semibold text-sm;
    }

    /* Code */
    :global(.content pre) {
      @apply bg-zinc-900 text-zinc-100 rounded-xl p-4 overflow-x-auto my-6;
    }

    :global(.content pre code) {
      @apply bg-transparent p-0 text-sm;
    }

    /* bg-zinc-100 was hardcoded: unreadable in dark mode (1.6:1). */
    :global(.content code) {
      @apply bg-[var(--color-code-background)] px-1 py-0.5 rounded text-sm;
    }

    /* Mobile table scrolling */
    @media (max-width: 899px) {
      :global(.content table) {
        @apply block overflow-x-auto whitespace-nowrap;
      }
    }

    /* Desktop */
    @media (min-width: 900px) {
      :global(.content, .contentFooter) {
        @apply my-[4rem] max-w-[80rem];
      }

      :global(.content .contentSection) {
        @apply mb-[10rem];
      }
    }
  </style>
</div>
