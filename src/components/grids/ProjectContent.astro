---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import MetaCard from '@/components/content/MetaCard.astro';
import ProjectThumbnail from '@/components/content/ProjectThumbnail.astro';
import ContentFooter from '@/components/content/ContentFooter.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  baseUrl?: string;
}

// load the data
const { project, baseUrl } = Astro.props;

const { Content } = await render(project);
---

<div class="project-content">
  <!-- Project Meta -->
  <div class="mt-[12rem] mb-[4rem]">
    <MetaCard project={project} />
  </div>
  <div class="projectThumbnail">
    <ProjectThumbnail project={project} />
  </div>

  <!-- Markdown content -->
  <article class="content custom-markdown">
    <Content />
  </article>

  <ContentFooter project={project} baseUrl={baseUrl}>
    <!-- <img src=`${baseUrl}images/projects/multi-multi/prototype.gif` alt="" loading="lazy" decoding="async" class="w-full object-cover" /> -->
  </ContentFooter>

  <style>
    @reference "@/styles/global.css";

    /* Base: Mobile */
    :global(.content, .contentFooter) {
      @apply px-[1.5rem] my-[6rem] mx-auto;
    }

    :global(.content .contentSection) {
      @apply mb-[6rem];
    }

    :global(.content h1),
    :global(.content h2),
    :global(.content h3),
    :global(.content h4) {
      @apply mt-[3rem];
    }

    :global(.content h5),
    :global(.content h6) {
      @apply mt-[2rem];
    }

    /* Project sections */
    :global(.content .projectGoal) {
      @apply grid grid-cols-1 md:grid-cols-3 gap-6;
    }

    :global(.content .projectGoal img) {
      @apply h-full object-cover;
    }

    /* Lists */
    :global(.content ul) {
      @apply list-none pl-0;
    }

    :global(.content ul li) {
      @apply before:content-['-'] before:mr-2 flex items-start;
    }

    :global(.content ol) {
      @apply list-none pl-0;
      counter-reset: item;
    }

    :global(.content ol li) {
      counter-increment: item;
      @apply flex items-start;
    }

    :global(.content ol li::before) {
      content: counter(item) '.';
      @apply mr-2 font-semibold flex-shrink-0;
    }

    /* Links */
    :global(.content a) {
      @apply underline;
    }

    /* Images */
    :global(.content img) {
      @apply mx-auto;
    }

    :global(.content video) {
      @apply mx-auto w-full rounded-[1rem];
    }

    /* Portrait capture: full width would run past 2600px tall. */
    :global(.content video.phone) {
      @apply block max-w-[20rem];
    }

    /* Layout */
    :global(.content .colsLayout) {
      @apply flex flex-col lg:flex-row items-center gap-8;
    }

    :global(.content .col) {
      @apply flex-1;
    }

    /* Embed */
    :global(.content .embedFrame) {
      @apply mx-auto w-full max-w-screen-lg aspect-[16/9];
    }

    /* Tables */
    :global(.content table) {
      @apply w-full my-8 border-collapse;
    }

    :global(.content th),
    :global(.content td) {
      @apply border px-4 py-3 align-top text-left;
    }

    :global(.content th) {
      @apply font-semibold text-sm;
    }

    /* Code */
    :global(.content pre) {
      @apply bg-zinc-900 text-zinc-100 rounded-xl p-4 overflow-x-auto my-6;
    }

    :global(.content pre code) {
      @apply bg-transparent p-0 text-sm;
    }

    /* bg-zinc-100 was hardcoded: unreadable in dark mode (1.6:1). */
    :global(.content code) {
      @apply bg-[var(--color-code-background)] px-1 py-0.5 rounded text-sm;
    }

    /* Mobile table scrolling */
    @media (max-width: 899px) {
      :global(.content table) {
        @apply block overflow-x-auto whitespace-nowrap;
      }
    }

    /* Desktop */
    @media (min-width: 900px) {
      :global(.content, .contentFooter) {
        @apply my-[4rem] max-w-[80rem];
      }

      :global(.content .contentSection) {
        @apply mb-[10rem];
      }
    }
  </style>
</div>
