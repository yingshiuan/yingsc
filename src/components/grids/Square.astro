---
import { getCollection } from 'astro:content';
import ProjectCard from '@/components/grids/ProjectCard.astro';
import Button from '@/components/UI/Button.astro';

const projects = await getCollection('projects');
projects.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;

  const aDate = a.data.created;
  const bDate = b.data.created;

  if (!aDate && !bDate) return 0;
  if (!aDate) return 1;
  if (!bDate) return -1;

  return new Date(bDate).getTime() - new Date(aDate).getTime();
});
---

<div class="gridLayout" id="projects-grid">
  {
    projects.map((project, index) => (
      <div
        class={`project-item ${index < 3 ? '' : 'hidden'}`}
        id={`project-${index}`}
        tabindex="-1"
      >
        <ProjectCard project={project} />
      </div>
    ))
  }

  <!-- Coming Soon Card -->
  <div
    class={`project-item ${projects.length < 3 ? '' : 'hidden'}`}
    tabindex="-1"
  >
      <div
        class="p-6 border rounded-xl flex flex-col items-center justify-center text-center h-full
            hover:shadow-lg dark:hover:shadow-gray-500 transition-shadow"
      >
        <span class="text-4xl mb-2">✨</span>
        <h3 class="text-xl font-semibold">More projects coming soon</h3>
        <p class="text-sm opacity-80 mt-2">
          This portfolio is being updated — only my most recent work is
          published for now.
        </p>
        <p class="text-sm opacity-80 mt-2">
          If you'd like to see more or talk about working together, <a
            href="#contact"
            class="underline underline-offset-2 hover:opacity-100">feel free to
            reach out</a
          >.
        </p>
      </div>
  </div>

  <!-- {
    projects.length > 0 ? (
      projects.map((project) => (
        <ProjectCard project={project} />
      ))
    ) : (
      <p>No projects found.</p>
    )
  } -->
</div>

<div class="moreButton">
  <div class="flex justify-end gap-2">
    {
      projects.length > 3 && (
        <Button
          id="load-more-button"
          label="Load more projects..."
          variant="outline"
          color="primary"
          size="md"
        />
      )
    }
    <!-- <Button
      href={`${baseUrl}projects`}
      label="View all projects →"
      variant="outline"
      color="primary"
      size="md"
    /> -->
  </div>
  <p id="load-more-status" class="sr-only" role="status" aria-live="polite"></p>
</div>

<script>
  const btn = document.getElementById('load-more-button');
  const status = document.getElementById('load-more-status');

  if (btn) {
    btn.addEventListener('click', () => {
      const items =
        document.querySelectorAll<HTMLElement>('.project-item.hidden');
      const toShow = Array.from(items).slice(0, 3); // show 3 more
      toShow.forEach((item) => item.classList.remove('hidden'));

      const remaining = document.querySelectorAll('.project-item.hidden').length;


      if (status) {
        status.textContent = `${toShow.length} more project${
          toShow.length === 1 ? '' : 's'
        } shown, ${remaining} remaining.`;
      }

      // hide button if all items are now visible
      if (remaining === 0) {
        toShow[0]?.focus();
        btn.style.display = 'none';
      }
    });
  }
</script>

<style>
  @reference "@/styles/global.css";
  .gridLayout {
    @apply p-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-4;
  }
  .moreButton {
    @apply px-[2.5rem] my-[2rem] mx-auto max-w-[80rem];
  }

  .project-item {
    @apply grid flex-col;
  }

  .project-item.hidden {
    display: none;
  }
</style>
