---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Tag from '@/components/UI/Tag.astro';
import TitleTag from '@/components/UI/TitleTag.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props as Props;

const baseUrl = import.meta.env.BASE_URL ?? '/';
const href = `${baseUrl}projects/${project.id}`;
---

<div class="project_card group">
  <a href={href} class="block">
    <div class="square_item relative overflow-hidden">
      <Image
        src={project.data.image}
        alt={project.data.title}
        widths={[320, 640, 960]}
        sizes="(min-width: 900px) 30rem, 100vw"
        class="img-default"
      />
      <Image
        src={project.data.hoverImage}
        alt=""
        aria-hidden="true"
        widths={[320, 640, 960]}
        sizes="(min-width: 900px) 30rem, 100vw"
        class="img-hover"
      />
      <!-- <picture class="hoverImage">
        <source srcset={project.data.hoverImage} type="image/webp" />
        <img src={project.data.hoverImage} alt={project.data.title + ' hover'} class="w-full h-full object-cover" />
      </picture> -->
    </div>
    <div class="w-full text-center p-2 flex-1">
      <div class="w-full text-start flex-1">
        <div class="flex justify-center items-center">
          <TitleTag tags={project.data.type} />
        </div>
      </div>
      <h4 class="square_title">{project.data.title}</h4>
      {
        project.data.subtitle && (
          <p class="square_subTitle">{project.data.subtitle}</p>
        )
      }
      {
        project.data.info && (
          <p class="square_description">{project.data.info}</p>
        )
      }
      <div class="flex justify-center items-center">
        <Tag
          tags={project.data.domains?.length
            ? project.data.domains
            : project.data.tags}
        />
      </div>
      <!-- <div class="flex justify-center items-center">
        <Tag
          tags={project.data.stack?.length
            ? project.data.stack
            : project.data.tags}
        />
      </div> -->
      <div
        class="flex justify-center items-center m-[0.25rem] text-sm font-light"
      >
        {
          (project.data.stack?.length
            ? project.data.stack
            : project.data.tags
          )?.join(' · ')
        }
      </div>
    </div>
  </a>
</div>

<style>
  @reference "@/styles/global.css";
  .project_card {
    @apply rounded-[1rem] bg-[var(--color-work-background)] p-[1rem] relative flex flex-col justify-end overflow-hidden;
  }

  body.light_mode .project_card.group:hover {
    @apply bg-gradient-to-t from-black/5 via-black/2 to-transparent
    border border-black/10;
  }

  body.dark_mode .project_card.group:hover {
    @apply bg-gradient-to-t from-white/20 via-white/10 to-white/5
    border border-white/25;
  }

  .square_item {
    @apply w-full overflow-hidden rounded-[1rem];
  }
  .square_title {
    @apply text-[var(--color-text-primary)] text-center mt-2 font-semibold;
  }
  .square_subTitle {
    @apply text-[var(--color-text-primary)] text-center text-sm line-clamp-1 opacity-70;
  }
  .square_description {
    @apply text-[var(--color-text-primary)] text-center text-sm line-clamp-2;
  }

  .img-default {
    @apply w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-0;
  }

  .img-hover {
    @apply absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-300 group-hover:opacity-100;
  }

  .tooltip {
    @apply invisible absolute w-max bottom-[-3rem] -translate-x-1/3 bg-[var(--color-header)] p-[0.2rem] z-10 rounded-sm group-hover:visible;
  }
</style>
