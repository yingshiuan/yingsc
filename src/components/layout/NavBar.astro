---
const { baseUrl } = Astro.props;

interface NavLink {
  label: string;
  href: string;
}

const links: NavLink[] = [
  { label: 'Home', href: `${baseUrl}` },
  { label: 'Projects', href: `${baseUrl}projects` },
  { label: 'Resume', href: `${baseUrl}resume` },
  { label: 'About', href: `${baseUrl}about` },
];
---

<script>
  // Bundled module scripts are deferred, so the DOM is already parsed here and
  // there is nothing to wait for.
  {
    const toggle = document.getElementById('nav-toggle');

    const setOpen = (open: boolean) =>
      toggle?.setAttribute('aria-expanded', String(open));

    toggle?.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (toggle?.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
      toggle.focus();
    });

    // Following a link leaves the panel open behind the navigation otherwise.
    document.querySelectorAll('#navbar a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  }

  {
    const currentPath = window.location.pathname.replace(/\/$/, '');
    const items = document.querySelectorAll<HTMLLIElement>('#navbar .item');

    items.forEach((item) => {
      const link = item.querySelector('a')!;
      const linkPath = new URL(
        link.href,
        window.location.origin
      ).pathname.replace(/\/$/, '');
      if (linkPath === currentPath) {
        item.classList.add('active-link');
      }
    });
  }
</script>

<nav id="mynav">
  <button
    id="nav-toggle"
    class="navbarToggle"
    aria-label="Toggle menu"
    aria-expanded="false"
    aria-controls="navbar">
    <i class="material-symbols-outlined menu-icon" aria-hidden="true">menu</i>
    <i class="material-symbols-outlined close-icon" aria-hidden="true">close</i>
  </button>

  <ul id="navbar">
    {
      links.map((link) => (
        <li class="item">
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  @reference "@/styles/global.css";

  /* ===========================
   Base (mobile first)
   =========================== */
  nav {
    @apply flex items-center ml-auto;
  }

  .navbarToggle {
    @apply flex items-center border-none bg-transparent text-white text-2xl
      cursor-pointer p-0;
  }

  .navbarToggle:focus-visible {
    @apply outline-2 outline-offset-2 outline-white rounded-sm;
  }

  /* --- Icon toggle logic, driven entirely by aria-expanded --- */
  .navbarToggle .close-icon {
    @apply hidden;
  }

  .navbarToggle[aria-expanded='true'] .menu-icon {
    @apply hidden;
  }

  .navbarToggle[aria-expanded='true'] .close-icon {
    @apply block;
  }

  #navbar {
    @apply hidden absolute top-full left-0 right-0 z-10 m-0 list-none flex-col bg-[var(--color-header)] shadow-lg;
  }

  .navbarToggle[aria-expanded='true'] + #navbar {
    @apply flex;
  }

  .item {
    @apply w-full text-center py-[0.5rem];
  }

  .item:hover {
    @apply rounded-full bg-gradient-to-t from-white/20 via-white/10 to-white/5
      backdrop-blur-md border border-white/25;
  }

  .item a {
    @apply text-white;
  }

  /* Active border */
  .active-link {
    @apply rounded-full bg-gradient-to-t from-white/20 via-white/10 to-white/5
    backdrop-blur-md border border-white/25;
  }

  /* ===========================
   Larger screens (>=900px)
   =========================== */

  @media (min-width: 900px) {
    nav {
      @apply max-w-[80rem] mx-auto flex justify-center items-center;
    }

    .navbarToggle {
      @apply hidden;
    }

    #navbar {
      @apply static flex flex-row min-w-0 bg-transparent rounded-none
        shadow-none;
    }

    .item {
      @apply w-auto px-4 py-0 text-white py-[0.5rem];
    }
  }
</style>
