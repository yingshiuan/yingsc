---
import NavBar from '@/components/layout/NavBar.astro';
import '@/styles/global.css';

const { siteTitle = 'Ying' } = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
---

<script>
  type AppliedMode = 'light_mode' | 'dark_mode';
  type Mode = AppliedMode | 'tonality';

  const modeIcons: Record<Mode, string> = {
    tonality: 'tonality',
    light_mode: 'light_mode',
    dark_mode: 'dark_mode',
  };

  const systemDark = matchMedia('(prefers-color-scheme: dark)');

  function getUserPreference(): Mode {
    try {
      return (localStorage.getItem('mode') as Mode) || 'tonality';
    } catch {
      return 'tonality';
    }
  }

  function saveUserPreference(userPreference: Mode): void {
    try {
      localStorage.setItem('mode', userPreference);
    } catch {
      // Storage blocked. The choice still holds for this page view, it just
      // will not survive a reload.
    }
  }

  function getAppliedMode(userPreference: Mode): AppliedMode {
    if (userPreference === 'light_mode') return 'light_mode';
    if (userPreference === 'dark_mode') return 'dark_mode';

    // If "tonality" → follow system preference
    return systemDark.matches ? 'dark_mode' : 'light_mode';
  }

  function rotatePreferences(userPreference: Mode): Mode {
    switch (userPreference) {
      case 'tonality':
        return 'light_mode';
      case 'light_mode':
        return 'dark_mode';
      case 'dark_mode':
        return 'tonality';
      default:
        return 'tonality';
    }
  }

  function setAppliedMode(applied: AppliedMode, userPreference: Mode): void {
    const root = document.documentElement;
    root.classList.remove('light_mode', 'dark_mode');
    root.classList.add(applied);

    // Update <meta name="color-scheme">
    const colorScheme = document.querySelector<HTMLMetaElement>(
      'meta[name="color-scheme"]'
    );
    if (!colorScheme) return;

    colorScheme.content =
      userPreference === 'tonality'
        ? 'light dark'
        : applied.replace('_mode', '');
  }

  function initScrollBar() {
    let prevScrollPos = window.pageYOffset;
    const scrollBar = document.getElementById('scroll');
    if (!scrollBar) return;

    window.addEventListener('scroll', () => {
      const currentScrollPos = window.pageYOffset;

      if (prevScrollPos > currentScrollPos) {
        scrollBar.style.top = '2rem'; // scrolling up → show
      } else {
        scrollBar.style.top = '-7rem'; // scrolling down → hide
      }

      prevScrollPos = currentScrollPos;
    });
  }

  function init(): void {
    let userPreference: Mode = getUserPreference();

    const themeDisplay = document.getElementById('mode') as HTMLElement | null;
    const themeTooltip = document.getElementById(
      'mode-tooltip'
    ) as HTMLElement | null;
    const themeToggler = document.getElementById(
      'mode-button'
    ) as HTMLButtonElement | null;


    function render(): void {
      const appliedMode = getAppliedMode(userPreference);
      setAppliedMode(appliedMode, userPreference);

      // Icon shows the stored preference, tooltip shows what it resolves to.
      if (themeDisplay) themeDisplay.innerText = modeIcons[userPreference];
      if (themeTooltip) themeTooltip.innerText = appliedMode.replace('_', ' ');
    }

    themeToggler?.addEventListener('click', () => {
      userPreference = rotatePreferences(userPreference);
      saveUserPreference(userPreference);
      render();
    });

    systemDark.addEventListener('change', () => {
      if (userPreference === 'tonality') render();
    });

    render();
  }
  init();
  initScrollBar();
</script>

<header>
  <div class="header-container">
    <div class="flex flex-col">
      <!-- Positioning anchor for NavBar's mobile dropdown: this box spans the
           full header width (the padding lives on .theme-bar inside it), so a
           panel with left-0 right-0 fills the page. Was `sticky`, which with no
           offsets behaved identically but read as accidental. -->
      <div class="items-center relative">
        <div class="logo">
          <!-- Replace with your logo or <img> if needed -->
        </div>

        <div class="theme-bar">
          <div class="flex relative group items-center py-[0.5rem]">
            <a href=`${baseUrl}` class="theme-link">
              {siteTitle}
            </a>
            <span class="tooltip">"Nice to meet you!"</span>
          </div>
          <NavBar baseUrl={baseUrl} />
          <div class="relative items-center group">
            <button
              id="mode-button"
              class="mode-button"
              aria-label="Toggle theme">
              <span class="material-symbols-outlined" id="mode">tonality</span>
            </button>
            <span class="tooltip" id="mode-tooltip">mode</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<div id="scroll" class="scroll-bar">
  <p>Currently shipping to a client's production codebase · open to <b>frontend, product & UX engineering roles</b></p>
</div>

<style>
  @reference "@/styles/global.css";

  .header-container {
    @apply top-0 left-0 right-0 fixed z-[100] bg-[var(--color-header)] opacity-90;
  }

  .theme-bar {
    @apply flex justify-between items-center px-[5rem] py-[0.5rem];
  }

  .theme-link {
    @apply text-white hover:text-[var(--color-text-hover)] hover:text-shadow-[0.05rem_0.05rem_var(--color-text-primary)];
  }

  .mode-button {
    /* The header is always the dark navy --color-header, in both themes, so the hover color is fixed here rather than taken from a theme token. */
    @apply text-white bg-transparent border-0 cursor-pointer text-[1.5rem] relative hover:text-white/70 items-center;
  }

  .scroll-bar {
    @apply block text-center mt-[1.5rem] py-[0.5rem] bg-[var(--color-work-background)] text-[var(--color-text-primary)] z-[98] shadow-[0_0.5px_6px_var(--color-rule)] backdrop-blur-md;
  }

  .scroll-bar p {
    @apply m-0;
  }
  
  .tooltip {
    @apply invisible absolute w-max bottom-[-3rem] -translate-x-1/3 bg-[var(--color-header)] p-[0.2rem] z-10 rounded-sm group-hover:visible;
  }

  /* Arrow */
  .tooltip::after {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 30%;
    margin-left: -0.5rem;
    border-width: 0.5rem;
    border-style: solid;
    border-color: transparent transparent #2c2c2c transparent; /* Arrow */
  }

  @media all and (max-width: 900px) {
    .header-container {
      opacity: 100%;
    }

    .theme-bar {
      @apply px-[1.5rem] py-[0.5rem];
    }

    .infoBar {
      position: fixed;
      margin: 1rem auto 0rem auto;
      padding-top: 0.2rem;
    }
  }
</style>
