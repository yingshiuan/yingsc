---
import { getCollection } from 'astro:content';
import Button from '@/components/UI/Button.astro';

interface Props {
  profileImage?: string;
  gifImage?: string;
}

const aboutCollection = await getCollection('about');
const aboutData = aboutCollection[0]?.data;
const homepage = aboutData?.homepage;

const {
  profileImage = aboutData?.profileImage ?? 'images/about/ying.jpg',
  gifImage = aboutData?.gifImage ?? 'images/about/hihi.webp',
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;

const profileImagePath = `${baseUrl}${profileImage}`;
const gifImagePath = `${baseUrl}${gifImage}`;
---

<section class="aboutMe">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Text section -->
    <div class="lg:col-span-9 space-y-6">
      {
        homepage?.label && (
          <p class="section_label">{homepage.label}</p>
        )
      }
      <h3>{homepage?.heading}</h3>
      {homepage?.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <!-- Images section -->
    <div class="lg:col-span-3 flex flex-col items-center gap-4">
      <div class="static_image group">
        <!-- static profile image -->
        <img
          src={profileImagePath}
          alt="ying"
          class="profile_image group-hover:opacity-0"
        />

        <!-- GIF image -->
        <img
          src={gifImagePath}
          alt="ying-hihi"
          class="profile_image absolute top-0 left-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        />
      </div>
    </div>

    <!-- Additional text -->
    <div class="lg:col-span-12 space-y-4">
      <div class="flex justify-end">
        <Button
          href={`${baseUrl}about`}
          label="More about me"
          color="primary"
          variant="outline"
          size="md"
        />
      </div>
    </div>
  </div>
</section>

<style>
  @reference "@/styles/global.css";
  .aboutMe {
    @apply px-[2.5rem] my-[4rem] mx-auto max-w-[80rem];
  }

  /* Matches the signposts on Technical Focus / Experience / Contact. */
  .section_label {
    @apply uppercase text-sm tracking-widest text-[var(--color-text-secondary)];
  }

  .static_image {
    @apply relative w-72 h-72;
  }

  .profile_image {
    @apply w-full h-full rounded-full transition-opacity duration-500;
  }

  .showgif {
    @apply hidden;
  }
</style>
