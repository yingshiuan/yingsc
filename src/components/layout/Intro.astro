---
import Tag from '@/components/UI/Tag.astro';

// const tags = [
//   'Interaction Design',
//   'UX/UI & Product Design',
//   'Human-Robot Collaboration',
//   'Digital Fabrication',
//   'Architecture',
// ];

const {
  greeting = 'Hi there!',
  name = 'Ying-Shiuan Chen',
  // headline = 'Front-End Engineer with a foundation in Interaction Design',
  role = 'Interaction Designer & Product-Focused Developer',
  intro = 'creating playful, human-centered experiences with Full-Stack, AI, and AR/VR technologies.',
  description = 'I build interactive web applications, AR/VR prototypes, and data visualization tools that connect user needs with technical execution. My background in architecture, robotic fabrication, and front-end development allows me to craft experiences that are both technically robust and genuinely enjoyable to use.',
  skills = [
    'Full-Stack Development',
    'UX-Driven Web & Interactive Apps',
    'AI-Enhanced Products & Data Visualization',
    'AR/VR & Interactive Experiences',
  ],
} = Astro.props;

---

<script></script>

<div class="intro">
  <p class="intro_item">{greeting}</p><br /><p class="intro_item">I am</p>
  <h1 class="intro_item">{name}</h1>
  <br />
  <p class="intro_item">An</p>
  <h2 class="intro_item">{role}</h2>
  <p class="intro_item">{intro}</p>
  <div class="mt-[2rem]">
    <Tag tags={skills} />
  </div>

</div>

<div class="intro">
  <p>
    {description}
  </p>
  <div class="flex justify-end items-end"><p class="intro_item"><span class="material-symbols-outlined">location_on</span>Based in Zürich</p></div>
</div>



<style>
  @reference "@/styles/global.css";
  .intro {
    @apply px-[2.5rem] my-[12rem] mx-auto;
  }

  .intro_item {
    @apply pt-[0.1rem] m-0;
  }

  @media (min-width: 900px) {
    .intro {
      @apply my-[4rem] max-w-[80rem];
    }
  }
</style>
