---
import { getCollection } from 'astro:content';
import Tag from '@/components/UI/Tag.astro';

const introCollection = await getCollection('intro');
const introEntry = introCollection[0];
const introContent = introEntry?.data ?? {};

const {
  name = introContent.name ?? 'Ying-Shiuan Chen',
  role = introContent.role ?? 'Product Engineer',
  intro = introContent.intro ?? '',
  description = introContent.description ?? '',
  skills = Array.isArray(introContent.skills) ? introContent.skills : [],
  previously = introContent.previously ?? [],
  studies = introContent.studies ?? {
    institution: 'ETH Zürich',
    url: 'https://ethz.ch/en.html',
  },
} = Astro.props;
---

<script></script>

<div class="intro">
  <h1 class="intro_item">{name}</h1>
  <br />
  <h2 class="intro_item">{role}</h2>
  <p class="intro_item">{intro}</p>
  <div class="mt-[2rem]">
    <Tag tags={skills} />
  </div>
</div>

<div class="intro">
  <div class="mt-[2rem]">
    <p>
      {description}
    </p>
  </div>
  <div class="mt-[2rem] flex justify-end items-center gap-2">
    <span>Previously at</span>
    {
      previously.map((company: { company: string; url: string }) => (
        <a
          href={company.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1 hover:underline">
          <img
            src={`https://www.google.com/s2/favicons?domain=${new URL(company.url).hostname}&sz=64`}
            alt={company.company}
            class="h-8 w-8"
          />
          <b>{company.company}</b>
        </a>
      ))
    }
  </div>
  <div class="mt-[2rem] flex justify-end items-center gap-2">
    <span>Education:</span>
    <a
      href={studies.url}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-1 hover:underline">
      <img
        src={`https://www.google.com/s2/favicons?domain=${new URL(studies.url).hostname}&sz=64`}
        alt={studies.institution}
        class="h-8 w-8"
      />
      <b>{studies.institution}</b>
    </a>
  </div>
  <div class="mt-[2rem] flex justify-end items-end">
    <p class="intro_item">
      <span class="material-symbols-outlined">location_on</span>Based in Zürich
    </p>
  </div>
</div>

<style>
  @reference "@/styles/global.css";
  .intro {
    @apply px-[2.5rem] my-[12rem] mx-auto;
  }

  .intro_item {
    @apply pt-[0.1rem] m-0;
  }

  @media (min-width: 900px) {
    .intro {
      @apply my-[4rem] max-w-[80rem];
    }
  }
</style>
