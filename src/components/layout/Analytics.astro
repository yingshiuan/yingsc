---
import Button from '@/components/UI/Button.astro';

interface Props {
  measurementId: string;
  requireConsent?: boolean;
}

const {
  measurementId,
  requireConsent = false
} = Astro.props;
---

<!-- Consent Mode Stub (required by Google) -->
