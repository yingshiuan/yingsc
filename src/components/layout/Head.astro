---
import SEO from '@/components/layout/SEO.astro';
import AEO from '@/components/layout/AEO.astro';
import type { SeoData } from '@/ts/type.ts';

const {
  title,
  description,
  image,
  url,
  keywords,
  alt,
  noindex = false,
  schemaType = 'WebPage',
} = Astro.props as SeoData;

const defaultKeywords = [
  "Product Engineer",
  "AI Product Engineer",
  "AI Applications",
  "Workflow Automation",
  "AI Agents",
  "Retrieval-Augmented Generation",
  "RAG",
  "n8n",
  "Full-Stack Development",
  "React",
  "TypeScript",
  "Node.js",
  "Human-Centered Design",
  "Interaction Design",
  "Rapid Prototyping",
  "Spatial Computing",
  "XR Interaction Systems",
  "Hardware-Software Integration",
  "Information Visualization",
  "Knowledge Visualization"
];

const seoKeywords = keywords ?? defaultKeywords;

const siteUrl = import.meta.env.SITE || 'https://yingshiuan.github.io';
const baseUrl = import.meta.env.BASE_URL;

const pageUrl = url ?? Astro.url.pathname;
const canonicalUrl = `${siteUrl}${pageUrl.startsWith('/') ? pageUrl : `/${pageUrl}`}`;

// og:image and twitter:image are ignored by every social platform unless they
// are absolute URLs. Pages may pass `images/x.png`, `/yingsc/x.png`, `./x.png`
// or a full URL — resolve all of them here, once, instead of in every page.
const siteRoot = `${siteUrl}${baseUrl}`;
// Default share card: public/yingsc.png, 1200x630 — the size Facebook,
// LinkedIn and Twitter all want. Pages only override it when they have
// something more specific to show (a project shows its own cover).
const absoluteImage = new URL(image ?? 'yingsc.png', siteRoot).href;

// Shared identifier for the site-wide Person entity emitted by <AEO />.
const personId = `${siteRoot}#person`;

// Pages set their own @type: AboutPage, CollectionPage, ProfilePage,
// CreativeWork for a project. Defaults to WebPage.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": schemaType,
  "name": title ?? 'Ying-Shiuan Chen',
  "description": description ?? 'Product Engineer building AI-powered applications, spatial computing experiences, and human-centered software through full-stack engineering, interaction design, and rapid prototyping.',
  "url": canonicalUrl,
  "image": absoluteImage,
  "inLanguage": "en",
  "keywords": seoKeywords,
  "author": { "@id": personId }
};
---

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const pref = localStorage.getItem("mode") || "tonality";
    const applied =
      pref === "light_mode"
        ? "light_mode"
        : pref === "dark_mode"
          ? "dark_mode"
          : window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark_mode"
            : "light_mode";

    document.body.className = applied;
    const meta = document.querySelector('meta[name="color-scheme"]');
    if (meta) meta.content = applied;
  });
</script>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="author" content="Ying-Shiuan Chen" />
  <meta name="copyright" content="Ying-Shiuan Chen" />
  <meta name="color-scheme" content="light dark" />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="google-site-verification" content="7x_392_0i3J2ueR1hniQdwveOFtObZQZRLa89TBTdXc" />
  <link rel="icon" type="image/svg+xml" href={`${baseUrl}yinz.svg`} />
  <link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl}yinz.png`} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <!-- The site-wide Person entity, generated from resume.json -->
  <AEO />
  <SEO
    title={title}
    description={description}
    image={absoluteImage}
    url={canonicalUrl}
    keywords={seoKeywords}
    alt={alt}
  />
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.gstatic.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&display=swap"
    rel="stylesheet"
  />
  <!--icon -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
  />
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
  />
  <!-- <meta name="generator" content={Astro.generator} /> -->
  <!-- Analytics (GA4 + GTM) live in layout/Analytics.astro, mounted from Layout.astro. -->
</head>
