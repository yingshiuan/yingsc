---
import type { SeoData } from '@/ts/type.ts';

const { title, description, image, url, keywords} = Astro.props as SeoData;
const fullTitle = `${title} | Ying-Shiuan Chen | Zürich`;
const ogImage = image ?? './yinz.svg';

const siteUrl = import.meta.env.SITE || 'https://yingshiuan.github.io';
const pageUrl = url ?? '/';
const canonicalUrl = `${siteUrl}${pageUrl.startsWith('/') ? pageUrl : `/${pageUrl}`}`;

const keywordString = Array.isArray(keywords) ? keywords.join(', ') : keywords ?? '';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": title ?? 'Ying-Shiuan Chen Portfolio',
  "description": description ?? '',
  "url": canonicalUrl,
  "image": ogImage,
  "keywords": keywordString,
  "author": {
    "@type": "Person",
    "name": "Ying-Shiuan Chen",
    "url": siteUrl
  }
};
---

<title>{fullTitle}</title>
<meta property="og:image" content={ogImage} />
<meta property="og:url" content={canonicalUrl} />
{description && <meta name="description" content={description} />}
{keywordString && <meta name="keywords" content={keywordString} />}
{url && <link rel="canonical" href={canonicalUrl} />}

<!-- Open Graph / Social Preview -->
<meta property="og:title" content={fullTitle} />
{url && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:type" content="website" />
{description && <meta property="og:description" content={description} />}
{image && <meta property="og:image" content={image} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
{description && <meta name="twitter:description" content={description} />}
{image && <meta name="twitter:image" content={image} />}

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
