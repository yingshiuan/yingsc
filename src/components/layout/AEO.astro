---
import type { ResumeData } from '@/ts/resume';
import resumeDataJson from '@/content/resume/resume.json';
import { buildPerson } from '@/ts/person';

interface Props {
  /** Overrides for the Person node. All optional — defaults come from resume.json. */
  name?: string;
  description?: string;
  image?: string;
  resumeData?: ResumeData;
}

const {
  name,
  description,
  image = 'images/about/ying.jpg',
  resumeData = resumeDataJson as ResumeData,
} = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://yingshiuan.github.io';
const siteRoot = `${siteUrl}${import.meta.env.BASE_URL}`;

// One @id for the whole site. Head.astro references the same value from every
// page's `author`, so crawlers merge both into a single Person entity instead
// of treating them as two different people.
const person = buildPerson(resumeData, {
  personId: `${siteRoot}#person`,
  url: siteRoot,
  image: new URL(image, siteRoot).href,
  name,
  description,
});
---

<script type="application/ld+json" set:html={JSON.stringify(person)} />
