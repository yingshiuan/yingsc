---
import type { CollectionEntry } from 'astro:content';
import Tag from '@/components/UI/Tag.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props as Props;
---

<section class="meta space-y-16">
  <div class="space-y-16">
    <h1 class="projectTitle">{project.data.title}</h1>
    <p class="projectDescription">{project.data.description}</p>
    <div class="my-[2rem]">
      {project.data.tags && <Tag tags={project.data.tags} />}
    </div>
  </div>

  <ul class="projectDetail grid grid-cols-1 md:grid-cols-4 gap-6 list-none">
    {
      project.data.role && (
        <li>
          <ol>Role:</ol>
          <ol>{project.data.role}</ol>
        </li>
      )
    }
    {
      project.data.timeline && (
        <li>
          <ol>Timeline:</ol>
          <ol>{project.data.timeline}</ol>
        </li>
      )
    }
    {
      project.data.completed && (
        <li>
          <ol>Completed:</ol>
          <ol>{project.data.completed}</ol>
        </li>
      )
    }
    {
      project.data.credit && (
        <li>
          <ol>Credit:</ol>
          <ol>{project.data.credit}</ol>
        </li>
      )
    }

    <!-- Tools full width -->
    {
      project.data.tools && (
        <li class="col-span-1 md:col-span-4">
          <ol>Tools & Technologies:</ol>
          <ol>{project.data.tools.join(', ')}</ol>
        </li>
      )
    }

    <!-- focus full width -->
    {
      project.data.focus && project.data.focus.length > 0 && (
        <li class="col-span-1 md:col-span-4">
          <ol>Focus:</ol>
          <ol>{project.data.focus.join(', ')}</ol>
        </li>
      )
    }

    <!-- Activities full width -->
    {
      project.data.activities && (
        <li class="col-span-1 md:col-span-4">
          <ol>Activities:</ol>
          <ol>{project.data.activities}</ol>
        </li>
      )
    }
  </ul>
</section>

<style>
  @reference "@/styles/global.css";

  .meta {
    @apply max-w-[80rem] mx-auto my-8 px-[2.5rem];
  }

  .projectDetail {
    @apply border rounded-sm p-[0.5rem];
  }

  .projectDetail ol {
    @apply pb-[0.25rem];
  }
</style>
