---
interface Props {
  tags: string | string[];
}

const { tags } = Astro.props;
---

{tags && (
  <ul class="tags_container">
    {Array.isArray(tags)
      ? tags.map((t) => <li class="tags">{t}</li>)
      : <li class="tags">{tags}</li>
    }
  </ul>
)}



<style>
  @reference "@/styles/global.css";
  .tags_container {
    @apply flex m-[1rem] gap-2 flex-wrap;
  }
  .tags {
    @apply text-xs uppercase text-[var(--color-text-secondary)] border-[1.5px] border-[var(--color-rule)] rounded-[6px] p-[0.2rem];
  }

  .tags:hover {
    @apply border-[var(--color-caption-primary)] bg-[var(--color-text-hover)] text-[var(--color-border)] shadow-[0.1rem_0.1rem_var(--color-caption-secondary)] transition duration-300;
  }

  @media (min-width: 900px) {
    .tags_container {
      @apply max-w-[80rem] mx-auto;
    }
  }
</style>
